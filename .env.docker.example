POSTGRES_DB=lms_db
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=replace_with_a_strong_database_password
# Use the Compose service name "postgres" as host. URL-encode special characters in the password.
DATABASE_URL=postgresql://lms_user:replace_with_a_strong_database_password@postgres:5432/lms_db?schema=public

# Used only by: docker compose run --rm seed-admin
# After the first admin is created, remove INITIAL_ADMIN_PASSWORD from .env.
INITIAL_ADMIN_NAME=Super Admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace_with_at_least_12_characters

JWT_ACCESS_SECRET=replace_with_a_strong_access_secret
JWT_REFRESH_SECRET=replace_with_a_strong_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=lms-backend
COOKIE_SECURE=true

# Public HTTPS domains served by Nginx.
FRONTEND_URL=https://lms.example.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace_with_php_gmail_address
SMTP_PASS=replace_with_php_gmail_app_password
SMTP_FROM=replace_with_php_gmail_address

PUBLIC_OTP_HASH_SECRET=replace_with_a_separate_strong_secret
PUBLIC_OTP_TTL_MINUTES=10
PUBLIC_OTP_RESEND_SECONDS=60
PUBLIC_CONTACT_TO=rahul.singh@eicetechnology.com,sameer.parashar@eicetechnology.com,amit.srivastava@eicetechnology.com
PUBLIC_CONTACT_BCC=uma.tripathi@eicetechnology.com,ankit.rawat@eicetechnology.com
PUBLIC_ENQUIRY_TO=HR@EICETECHNOLOGY.COM,harshita.chaurasiya@eicetechnology.com
