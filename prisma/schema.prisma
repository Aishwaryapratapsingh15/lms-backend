generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SALES
}

enum LeadSource {
  WEBSITE
  CALL
  SOCIAL_MEDIA
  REFERENCE
  PARTNER
  EMAIL
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  QUALIFIED
  PROPOSAL
  WON
  LOST
  PROJECT_IS_OURS
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
}

enum LeadType {
  INTERNAL
  EXTERNAL
}

enum FollowUpType {
  CALL
  EMAIL
  MEETING
  NOTE
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum TokenType {
  ACCESS
  REFRESH
}

enum LeadActivityType {
  CREATED
  UPDATED
  ASSIGNED
  AUTO_ASSIGNED
  SLA_REMINDER_SENT
  SLA_ESCALATED
  STATUS_CHANGED
  FOLLOW_UP_ADDED
  FOLLOW_UP_COMPLETED
  EMAIL_SENT
  ARCHIVED
  RESTORED
}

model User {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique
  password            String
  role                Role                 @default(SALES)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  leadsCreated        Lead[]               @relation("CreatedLeads")
  assignedLeads       Lead[]               @relation("AssignedLeads")
  followUps           LeadFollowUp[]
  sentEmails          EmailLog[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  leadActivities      LeadActivity[]
  emailSettingsEdits  EmailSettings[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  type      TokenType @default(REFRESH)
  expiresAt DateTime
  revoked   Boolean   @default(false)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Lead {
  id                String         @id @default(uuid())
  fullName          String
  email             String?
  phone             String?
  company           String?
  source            LeadSource     @default(WEBSITE)
  status            LeadStatus     @default(NEW)
  priority          LeadPriority   @default(MEDIUM)
  leadType          LeadType       @default(INTERNAL)
  assignedToId      String?
  createdById       String?
  notes             String?
  nextFollowUpAt    DateTime?
  archivedAt        DateTime?
  unassignedAt      DateTime?      @default(now())
  slaReminderSentAt DateTime?
  slaEscalatedAt    DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  assignedTo        User?          @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy         User?          @relation("CreatedLeads", fields: [createdById], references: [id], onDelete: SetNull)
  followUps         LeadFollowUp[]
  emailLogs         EmailLog[]
  activities        LeadActivity[]

  @@index([assignedToId, archivedAt, createdAt])
  @@index([assignedToId, archivedAt, unassignedAt])
  @@index([status, archivedAt])
  @@index([email])
  @@index([phone])
}

model LeadFollowUp {
  id                String       @id @default(uuid())
  leadId            String
  userId            String
  type              FollowUpType @default(CALL)
  notes             String
  nextFollowUpAt    DateTime?
  completedAt       DateTime?
  createdAt         DateTime     @default(now())
  calendarEventId   String?
  calendarSyncError String?
  teamsJoinUrl      String?
  // Mailbox the calendar event actually lives in — the lead's assigned
  // salesperson at creation time, not necessarily this follow-up's creator
  // (an Admin/SuperAdmin can log a follow-up on someone else's lead).
  // Recorded separately from userId so completion can delete the right
  // event even if the lead gets reassigned afterward.
  calendarMailbox   String?
  lead              Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([nextFollowUpAt, completedAt])
}

model LeadActivity {
  id        String           @id @default(uuid())
  leadId    String
  actorId   String?
  type      LeadActivityType
  details   Json?
  createdAt DateTime         @default(now())
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor     User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([actorId, createdAt])
}

model EmailLog {
  id        String      @id @default(uuid())
  leadId    String?
  userId    String?
  toEmail   String
  ccEmails  String[]
  bccEmails String[]
  subject   String
  body      String
  status    EmailStatus @default(PENDING)
  sentAt    DateTime?
  createdAt DateTime    @default(now())
  lead      Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// Singleton row (fixed id) holding the company-wide CC/BCC addresses that
// get merged into every lead email a salesperson sends, on top of whatever
// they type in themselves for that one email.
model EmailSettings {
  id          String   @id @default("global")
  ccEmails    String[] @default([])
  bccEmails   String[] @default([])
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

model PublicEmailOtp {
  email      String   @id
  otpHash    String   @map("otp")
  expiresAt  DateTime
  lastSentAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("email_otp")
}

model ContactSubmission {
  id          String   @id @default(uuid())
  name        String
  companyName String
  role        String?
  email       String
  phone       String
  phoneCode   String
  country     String?
  address     String
  requirement String
  product     String?
  message     String?
  createdAt   DateTime @default(now())

  @@map("contact_submissions")
}

model PublicFormSubmission {
  id        String   @id @default(uuid())
  name      String?
  email     String
  contact   String?
  service   String?
  message   String?
  createdAt DateTime @default(now())

  @@map("formmodel")
}
