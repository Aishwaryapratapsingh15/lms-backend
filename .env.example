# Copy this file to .env and fill in real values before starting the app.
# Vars marked REQUIRED have no safe default and the app refuses to boot
# without them (see assertRequiredEnv() in src/main.ts). Everything else is
# optional — the fallback used when it's unset is noted inline.

# --- Core ---
NODE_ENV=development
PORT=4000
DATABASE_URL=                     # REQUIRED — postgresql://user:pass@host:5432/db
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=                    # optional — leave unset for host-only cookies

# --- Auth ---
JWT_ACCESS_SECRET=                # REQUIRED — long random string, no fallback
JWT_REFRESH_SECRET=               # REQUIRED — long random string, no fallback
JWT_ISSUER=lms-backend
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PASSWORD_RESET_URL=               # e.g. https://app.example.com/reset-password

# --- Initial admin (seed-admin script) ---
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- Public form OTP (public-forms module) ---
PUBLIC_OTP_HASH_SECRET=           # falls back to JWT_ACCESS_SECRET if unset
PUBLIC_OTP_TTL_MINUTES=10
PUBLIC_OTP_RESEND_SECONDS=60
PUBLIC_OTP_MAX_ATTEMPTS=5
PUBLIC_ENQUIRY_TO=HR@EICETECHNOLOGY.COM,harshita.chaurasiya@eicetechnology.com
PUBLIC_CONTACT_TO=rahul.singh@eicetechnology.com,sameer.parashar@eicetechnology.com,amit.srivastava@eicetechnology.com
PUBLIC_CONTACT_BCC=uma.tripathi@eicetechnology.com,ankit.rawat@eicetechnology.com

# --- SMTP (outbound email) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Inbound email polling (optional feature) ---
INBOUND_EMAIL_ENABLED=false
INBOUND_EMAIL_CHECK_INTERVAL_MINUTES=5
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# --- Lead SLA automation (optional feature) ---
LEAD_SLA_ENABLED=false
LEAD_SLA_CHECK_INTERVAL_MINUTES=5
LEAD_SLA_REMINDER_MINUTES=15
LEAD_SLA_ASSIGN_MINUTES=30

# --- Teams meeting two-way sync (optional feature) ---
MEETING_SYNC_ENABLED=false
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
TEAMS_LEAD_WEBHOOK_URL=

# --- Misc ---
COMPANY_NAME=
LEAD_ACKNOWLEDGEMENT_ENABLED=true
LEAD_ASSIGNMENT_EMAIL_ENABLED=true
