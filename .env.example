# Application
NODE_ENV=production
PORT=4000

# PostgreSQL container and Prisma connection
POSTGRES_DB=lms_db
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=replace_with_a_strong_database_password
# Use host "postgres" with Docker Compose. URL-encode password special characters here.
DATABASE_URL=postgresql://lms_user:replace_with_a_strong_database_password@postgres:5432/lms_db?schema=public

# Authentication
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=lms-backend
COOKIE_SECURE=true

# Exact public URL of the separately deployed frontend; no trailing slash
FRONTEND_URL=https://lms.example.com

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace_with_php_gmail_address
SMTP_PASS=replace_with_php_gmail_app_password
SMTP_FROM=replace_with_php_gmail_address

# Public website forms and OTP
PUBLIC_OTP_HASH_SECRET=replace_with_a_separate_long_random_secret
PUBLIC_OTP_TTL_MINUTES=10
PUBLIC_OTP_RESEND_SECONDS=60
PUBLIC_CONTACT_TO=rahul.singh@eicetechnology.com,sameer.parashar@eicetechnology.com,amit.srivastava@eicetechnology.com
PUBLIC_CONTACT_BCC=uma.tripathi@eicetechnology.com,ankit.rawat@eicetechnology.com
PUBLIC_ENQUIRY_TO=HR@EICETECHNOLOGY.COM,harshita.chaurasiya@eicetechnology.com

# Used only once with: docker compose run --rm seed-admin
# Remove INITIAL_ADMIN_PASSWORD from the VPS .env after admin creation.
INITIAL_ADMIN_NAME=Super Admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace_with_at_least_12_characters
